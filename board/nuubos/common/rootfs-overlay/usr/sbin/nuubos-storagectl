#!/bin/sh
# nuubOS storage: the games card in the TF2 slot (docs/dev/platform.md
# "SD2 = games card", EPIC-032).
#
# SD1 holds the system and every piece of user data. SD2 is a content card
# used as it is (exFAT, FAT32, ext4; partitioned or not): libraryd reads its
# ROM folder, Files and Media show it. Removing it never costs progress.
#
#   status                    SD1 and SD2 state (key=value)
#   hotplug add|remove DISK   from udev (TF2 disk events)
#   sd2 attach                identify, repair if dirty, mount (boot, udev, Use)
#   sd2 eject                 flush and unmount; ERR busy while files are open
#   sd2 ignore                "Don't Use": the card is left unmounted, now
#                             and whenever it comes back
#   sd2 use                   use an ignored or ejected card (background)
#   sd2 prepare               create the game folders (job worker)
#   sd2 format <CID>          erase and format exFAT (job worker)
#   data apply                bind the data folders (boot, user switch)
#   data move CAT sd2|sd1     move a category of user data (job worker)
#   data forget CAT           the card is gone: CAT back on SD1, without
#                             what the card holds
#
# State (/run/nuubos/storage/sd2.status): SD2_SLOT=0|1, SD2_STATE=
# none|empty|checking|ready|readonly|unreadable|ejected, SD2_PATH (mount
# point while mounted), SD2_CID, SD2_FS, SD2_LABEL, SD2_REPAIRED=0|1,
# SD2_PROMPT=none|prepare|format (a card seen for the first time that needs
# the user's choice; cleared by ignore/prepare/format). SD2_STATE=ignored: a
# card the user chose not to use (CID in /state/storage/sd2-ignored). Every change pokes
# nuubos-systemd (snapshot to its subscribers) and libraryd (SCAN).
#
# Data on SD2 (GitHub #24, opt-in per category, all on SD1 by default):
# bios, saves, states, screenshots (with recordings), library (covers,
# metadata and the scraping cache). A category on SD2 lives in the card's
# nuubOS folder with SD1's layout (nuubOS/users/<id>/saves...) and is
# bind-mounted over its /userdata folder, so every service keeps its paths.
# The card is this console's by its nuubOS/.nuubos-data TOKEN (also in
# /state/storage/data.conf); all categories on SD2 share that one card.
# Without it (out, ejected, another card) each folder is an empty
# read-only tmpfs: nothing lands on SD1 meanwhile, nuubos-emud refuses
# games (bios, saves, states), Syncthing stops on the missing folder
# marker. A move copies first (nuubos-data-move), the folders read-only
# meanwhile; the SD1 side is reached through the TF1 view, which no bind
# covers. State: /run/nuubos/storage/data.status, DATA_ON=<categories>,
# DATA_STATE=none|online|offline|moving, DATA_MOVING, DATA_CONFLICTS (files
# of the last move kept in <destination>/conflicts/<date>).

. /usr/lib/nuubos/exfat-health.sh

STATUS_DIR=/run/nuubos/storage
SD1_STATUS="$STATUS_DIR/storage.status"
SD2_STATUS="$STATUS_DIR/sd2.status"
LOCK="$STATUS_DIR/sd2.lock"
MOUNT=/media/sd2
KNOWN_DIR=/state/storage
KNOWN="$KNOWN_DIR/sd2-known"
IGNORED="$KNOWN_DIR/sd2-ignored"
SYSTEMS=/usr/share/nuubos/systems.conf
DATA_CONF="$KNOWN_DIR/data.conf"
DATA_STATUS="$STATUS_DIR/data.status"
DATA_DIR="$MOUNT/nuubOS"
DATA_MARK="$DATA_DIR/.nuubos-data"
DATA_MOVE=/usr/lib/nuubos/nuubos-data-move
DATA_CATS="bios saves states screenshots library"
TF1=/run/nuubos/storage/tf1
PLACEHOLDER=nuubos-sd2-data
MOVING=""
# TF2 is MMC2 on every H700 board (kernel 0036); found by its controller,
# not by its device number.
HOST=4022000.mmc
LABEL=NUUBOS

log() { echo "nuubos-storage: $*" >&2; logger -t nuubos-storage "$*" 2>/dev/null; return 0; }
fail() { if [ -n "${NUUBOS_JOB_ID:-}" ]; then echo "@error $1"; else echo "ERR $1"; fi; exit 1; }
progress() { [ -n "${NUUBOS_JOB_ID:-}" ] && echo "@progress $1"; return 0; }

value() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -1; }

slot_present() { [ -d "/sys/bus/platform/devices/$HOST/mmc_host" ]; }

# Kernel name of the TF2 card disk, if a card is in.
card_disk()
{
    for d in /sys/block/mmcblk*; do
        [ -e "$d" ] || continue
        case "$(readlink -f "$d")" in */"$HOST"/*) basename "$d"; return 0 ;; esac
    done
    return 1
}

card_cid() { cat "/sys/block/$1/device/cid" 2>/dev/null; }

fs_type() { blkid -o value -s TYPE "$1" 2>/dev/null; }

supported() { case "$1" in exfat|vfat|ext4|ext3|ext2) return 0 ;; esac; return 1; }

# First partition with a supported filesystem, else the whole disk
# (unpartitioned "superfloppy" cards).
data_device()
{
    for p in /sys/block/"$1"/"$1"p*; do
        [ -e "$p" ] || continue
        dev="/dev/$(basename "$p")"
        supported "$(fs_type "$dev")" && { echo "$dev"; return 0; }
    done
    supported "$(fs_type "/dev/$1")" && { echo "/dev/$1"; return 0; }
    return 1
}

mounted() { awk -v m="$MOUNT" '$2 == m { f = 1 } END { exit !f }' /proc/mounts; }

write_status()
{
    mkdir -p "$STATUS_DIR"
    tmp="$SD2_STATUS.tmp.$$"
    {
        if slot_present; then echo "SD2_SLOT=1"; else echo "SD2_SLOT=0"; fi
        echo "SD2_STATE=$1"
        if mounted; then echo "SD2_PATH=$MOUNT"; else echo "SD2_PATH="; fi
        echo "SD2_CID=${CID:-}"
        echo "SD2_FS=${FS:-}"
        echo "SD2_LABEL=${VOLUME:-}"
        echo "SD2_REPAIRED=${REPAIRED:-0}"
        echo "SD2_PROMPT=${PROMPT:-none}"
    } > "$tmp" && mv "$tmp" "$SD2_STATUS"
}

# Keep what is known about the current card when only the state changes.
load_status()
{
    CID="$(value "$SD2_STATUS" SD2_CID)"
    FS="$(value "$SD2_STATUS" SD2_FS)"
    VOLUME="$(value "$SD2_STATUS" SD2_LABEL)"
    REPAIRED="$(value "$SD2_STATUS" SD2_REPAIRED)"
    PROMPT="$(value "$SD2_STATUS" SD2_PROMPT)"
}

announce()
{
    [ -n "$MOVING" ] || apply_data
    # The backup status depends on the card too; it pokes nuubos-systemd.
    if [ -x /usr/sbin/nuubos-sd2-backup ]; then
        /usr/sbin/nuubos-sd2-backup refresh >/dev/null 2>&1
    else
        nuubos-systemctl storage-changed >/dev/null 2>&1
    fi
    [ "${1:-}" = rescan ] && nuubos-libraryctl scan >/dev/null 2>&1
    return 0
}

toast()
{
    nuubos-notifyctl post storage.sd2 "storage.sd2.$1" ${2:+"$2"} >/dev/null 2>&1
    return 0
}

known() { [ -n "$1" ] && grep -qxF "$1" "$KNOWN" 2>/dev/null; }

ignored() { [ -n "$1" ] && grep -qxF "$1" "$IGNORED" 2>/dev/null; }

set_ignored()
{
    mkdir -p "$KNOWN_DIR"
    { grep -vxF "$1" "$IGNORED" 2>/dev/null | tail -n 31; [ "$2" = 1 ] && echo "$1"; } > "$IGNORED.tmp" &&
        mv "$IGNORED.tmp" "$IGNORED" && sync
}

remember()
{
    [ -n "$1" ] || return 0
    known "$1" && return 0
    mkdir -p "$KNOWN_DIR"
    # A few dozen cards at most; the oldest go first.
    { tail -n 63 "$KNOWN" 2>/dev/null; echo "$1"; } > "$KNOWN.tmp" &&
        mv "$KNOWN.tmp" "$KNOWN" && sync
}

key_of() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9'; }

# Folder holding the games: a roms folder in any case, else the card root.
roms_dir()
{
    for d in "$MOUNT"/*/; do
        [ -d "$d" ] || continue
        n="${d%/}"; n="${n##*/}"
        [ "$(key_of "$n")" = roms ] && { echo "${d%/}"; return 0; }
    done
    echo "$MOUNT"
}

# Does the card already hold games? A roms folder, or system folders at its
# root (ArkOS layout), named like a system id, folder, name or alias.
has_games()
{
    [ "$(roms_dir)" != "$MOUNT" ] && return 0
    keys="$(awk -F'|' '!/^#/ && NF >= 3 {
        print $1; print $2; print $3; n = split($7, a, ","); for (i = 1; i <= n; i++) print a[i] }' "$SYSTEMS" |
        while read -r k; do key_of "$k"; echo; done | sort -u)"
    for d in "$MOUNT"/*/; do
        [ -d "$d" ] || continue
        n="${d%/}"; n="$(key_of "${n##*/}")"
        [ -n "$n" ] && printf '%s\n' "$keys" | grep -qxF "$n" && return 0
    done
    return 1
}

# Repair a filesystem left dirty by a card pulled out without ejecting.
# Never on a mounted volume. 0 = clean or repaired, 1 = still damaged.
repair()
{
    REPAIRED=0
    case "$2" in
        exfat)
            nuubos_exfat_prepare "$1" "$STATUS_DIR/sd2.health" || return 1
            [ "$(nuubos_exfat_health_value "$STATUS_DIR/sd2.health" RESULT)" = REPAIRED ] && REPAIRED=1
            ;;
        vfat)
            command -v fsck.fat >/dev/null 2>&1 || return 0
            fsck.fat -a -w "$1" >/dev/null 2>&1
            case $? in 0) ;; 1) REPAIRED=1 ;; *) return 1 ;; esac
            ;;
        ext*)
            command -v e2fsck >/dev/null 2>&1 || return 0
            e2fsck -p "$1" >/dev/null 2>&1
            case $? in 0) ;; 1|2) REPAIRED=1 ;; *) return 1 ;; esac
            ;;
    esac
    return 0
}

mount_card()
{
    case "$2" in
        vfat|exfat) opts="nodev,nosuid,noexec,noatime,uid=0,gid=0,fmask=0022,dmask=0022,iocharset=utf8,errors=remount-ro" ;;
        ext*) opts="nodev,nosuid,noexec,noatime,errors=remount-ro" ;;
    esac
    [ "$(blockdev --getro "$1" 2>/dev/null)" = 1 ] && opts="ro,$opts"
    mkdir -p "$MOUNT" || return 1
    mount -t "$2" -o "$opts" "$1" "$MOUNT" 2>/dev/null && return 0
    mount -t "$2" -o "ro,$opts" "$1" "$MOUNT" 2>/dev/null
}

mount_readonly() { awk -v m="$MOUNT" '$2 == m { split($4, o, ","); for (i in o) if (o[i] == "ro") f = 1 } END { exit !f }' /proc/mounts; }

attach()
{
    quiet="${1:-}"
    # Boot (udev coldplug): the card is simply there, nothing to announce.
    [ -e /run/nuubos/ui-ready ] || quiet=1
    CID=""; FS=""; VOLUME=""; REPAIRED=0; PROMPT=none
    if ! slot_present; then
        write_status none; announce; return 0
    fi
    disk="$(card_disk)" || { mounted && umount -l "$MOUNT"; write_status empty; announce rescan; return 0; }
    CID="$(card_cid "$disk")"
    if ignored "$CID"; then
        # "Don't Use": never mounted, no question, no notification.
        mounted && umount -l "$MOUNT"
        write_status ignored
        announce rescan
        return 0
    fi
    if mounted; then
        load_status
        mount_readonly && write_status readonly || write_status ready
        announce; return 0
    fi
    write_status checking
    announce

    dev="$(data_device "$disk")" || {
        log "card $disk: no supported filesystem"
        known "$CID" || PROMPT=format
        write_status unreadable
        announce rescan
        [ -n "$quiet" ] || toast unreadable
        return 0
    }
    FS="$(fs_type "$dev")"
    VOLUME="$(blkid -o value -s LABEL "$dev" 2>/dev/null | tr -d '\t\n')"
    damaged=0
    repair "$dev" "$FS" || damaged=1
    if ! mount_card "$dev" "$FS"; then
        log "card $dev ($FS): mount failed"
        known "$CID" || PROMPT=format
        write_status unreadable
        announce rescan
        [ -n "$quiet" ] || toast unreadable
        return 0
    fi
    # A volume still damaged after the repair is only read.
    if [ "$damaged" = 1 ] && ! mount_readonly; then
        mount -o remount,ro "$MOUNT" 2>/dev/null
    fi
    if known "$CID"; then
        :
    elif has_games; then
        remember "$CID"
    else
        PROMPT=prepare
    fi
    if mount_readonly; then
        write_status readonly
        log "card $dev ($FS) mounted read-only"
        [ -n "$quiet" ] || toast readonly "name=$VOLUME"
    else
        write_status ready
        log "card $dev ($FS) mounted at $MOUNT"
        [ -n "$quiet" ] || toast inserted "name=$VOLUME"
    fi
    announce rescan
    [ -x /usr/sbin/nuubos-sd2-backup ] && /usr/sbin/nuubos-sd2-backup trigger attach >/dev/null 2>&1
    return 0
}

detach()
{
    prev="$(value "$SD2_STATUS" SD2_STATE)"
    CID=""; FS=""; VOLUME=""; REPAIRED=0; PROMPT=none
    if mounted; then
        # Pulled out without ejecting: detach now so nothing writes into
        # the mount point; open files fail instead of hanging.
        umount -l "$MOUNT" 2>/dev/null
    fi
    write_status empty
    announce rescan
    case "$prev" in
        ready|readonly)
            # A game running from the card is saved and closed (emud).
            nuubos-emuctl storage-lost "$MOUNT" >/dev/null 2>&1
            toast removed
            ;;
    esac
    log "card removed (was ${prev:-unknown})"
}

eject()
{
    state="$(value "$SD2_STATUS" SD2_STATE)"
    case "$state" in ready|readonly) ;; *) echo "ERR not-mounted"; return 1 ;; esac
    sync
    data_release || { echo "ERR busy"; return 1; }
    if ! umount "$MOUNT" 2>/dev/null; then
        apply_data
        echo "ERR busy"
        return 1
    fi
    load_status
    write_status ejected
    announce rescan
    toast ejected
    echo OK
}

ignore()
{
    load_status
    [ -n "$CID" ] || { echo "ERR absent"; return 1; }
    if mounted; then
        sync
        data_release || { echo "ERR busy"; return 1; }
        umount "$MOUNT" 2>/dev/null || { apply_data; echo "ERR busy"; return 1; }
    fi
    remember "$CID"
    set_ignored "$CID" 1
    PROMPT=none
    write_status ignored
    announce rescan
    echo OK
}

use()
{
    load_status
    [ -n "$CID" ] && set_ignored "$CID" 0
    attach
}

prepare()
{
    state="$(value "$SD2_STATUS" SD2_STATE)"
    [ "$state" = ready ] || fail not-ready
    progress -1
    dir="$(roms_dir)"
    [ "$dir" = "$MOUNT" ] && dir="$MOUNT/roms"
    mkdir -p "$dir" "$MOUNT/music" "$MOUNT/videos" || fail storage
    awk -F'|' '!/^#/ && NF >= 3 && $3 != "" { print $3 }' "$SYSTEMS" |
        while read -r f; do
            # An existing folder in another case (Roms/GBA) is kept.
            ls -d "$dir"/* 2>/dev/null | awk -v f="$f" '{ n = $0; sub(".*/", "", n) } tolower(n) == tolower(f) { found = 1 } END { exit !found }' ||
                mkdir -p "$dir/$f"
        done
    sync
    load_status
    remember "$CID"
    PROMPT=none
    write_status ready
    announce rescan
    echo "@progress 100"
}

format_card()
{
    expected="$1"
    [ -n "$expected" ] || fail cid
    disk="$(card_disk)" || fail absent
    CID="$(card_cid "$disk")"
    [ "$CID" = "$expected" ] || fail changed
    case "/dev/$disk" in "$(sed -n 's/.*root=\(\/dev\/mmcblk[0-9]*\).*/\1/p' /proc/cmdline)"*) fail boot-disk ;; esac
    # Never the card with the user's data: it moves back to SD1 first.
    [ -n "$(value "$DATA_CONF" ON)" ] && data_card && fail data
    progress 5
    if mounted; then
        sync
        data_release || fail busy
        umount "$MOUNT" 2>/dev/null || { apply_data; fail busy; }
    fi
    write_status checking
    announce rescan
    log "formatting /dev/$disk (CID $CID)"
    printf 'label: dos\nunit: sectors\n\nstart=2048, type=7\n' |
        sfdisk --wipe always --wipe-partitions always "/dev/$disk" >/dev/null 2>&1 || { attach quiet; fail format; }
    blockdev --rereadpt "/dev/$disk" 2>/dev/null
    udevadm settle 2>/dev/null
    progress 30
    [ -b "/dev/${disk}p1" ] || { attach quiet; fail format; }
    mkfs.exfat -L "$LABEL" "/dev/${disk}p1" >/dev/null 2>&1 || { attach quiet; fail format; }
    progress 80
    remember "$CID"
    set_ignored "$CID" 0
    attach quiet
    [ "$(value "$SD2_STATUS" SD2_STATE)" = ready ] || fail format
    prepare >/dev/null
    toast formatted
    echo "@progress 100"
}

# --- Data on SD2 ---------------------------------------------------------

data_on() { case ",$(value "$DATA_CONF" ON)," in *",$1,"*) return 0 ;; esac; return 1; }

# Folders of a category, relative to /userdata (every profile's).
cat_paths()
{
    case "$1" in
        bios) echo bios ;;
        library) echo library/covers; echo library/metadata; echo library/cache ;;
        saves|states|screenshots)
            for p in /state/users/*/profile.conf; do
                [ -f "$p" ] || continue
                u="${p%/profile.conf}"; u="${u##*/}"
                [ "$u" = default ] && continue
                if [ "$1" = screenshots ]; then
                    echo "users/$u/screenshots"; echo "users/$u/recordings"
                else
                    echo "users/$u/$1"
                fi
            done
            ;;
    esac
}

# The card in the slot holds this console's data.
data_card()
{
    case "$(value "$SD2_STATUS" SD2_STATE)" in ready|readonly) ;; *) return 1 ;; esac
    mounted || return 1
    token="$(value "$DATA_CONF" TOKEN)"
    [ -n "$token" ] && [ "$(value "$DATA_MARK" TOKEN)" = "$token" ]
}

# What covers /userdata/<rel>: "fstype source root" of the top mount.
mounted_at() { awk -v m="/userdata/$1" '$5 == m { for (i = 7; $i != "-"; i++); t = $(i + 1) " " $(i + 2) " " $4 } END { if (t != "") print t }' /proc/self/mountinfo; }

# Ours: the placeholder, or a folder of the card's nuubOS.
ours() { awk -v p="$PLACEHOLDER" '$5 ~ "^/userdata/" { for (i = 7; $i != "-"; i++); if ($(i + 2) == p || tolower($4) ~ "^/nuubos/") print $5 }' /proc/self/mountinfo; }

release_at() { while [ -n "$(mounted_at "$1")" ]; do umount -l "/userdata/$1" 2>/dev/null || break; done; }

placeholder()
{
    release_at "$1"
    mkdir -p "/userdata/$1" &&
        mount -t tmpfs -o ro,nosuid,nodev,noexec,size=4k,mode=0755 "$PLACEHOLDER" "/userdata/$1" ||
        log "data: no placeholder over $1"
}

write_data_status()
{
    mkdir -p "$STATUS_DIR"
    {
        echo "DATA_ON=$(value "$DATA_CONF" ON)"
        echo "DATA_STATE=$1"
        echo "DATA_MOVING=${2:-}"
        echo "DATA_CONFLICTS=$(value "$DATA_CONF" CONFLICTS)"
    } > "$DATA_STATUS.tmp" && mv "$DATA_STATUS.tmp" "$DATA_STATUS"
}

write_data_conf()
{
    mkdir -p "$KNOWN_DIR"
    { echo "ON=$1"; echo "TOKEN=$2"; echo "CONFLICTS=${3:-0}"; } > "$DATA_CONF.tmp" &&
        mv "$DATA_CONF.tmp" "$DATA_CONF" && sync
}

# Every folder of a category on SD2 bound to the card, or covered while
# the card is away; anything else of ours goes (a category back on SD1, a
# deleted profile). Only what differs changes: a running game keeps its
# folders.
apply_data()
{
    on="$(value "$DATA_CONF" ON)"
    state=none
    if [ -n "$on" ]; then
        if data_card; then state=online; else state=offline; fi
    fi
    dev="$(awk -v m="$MOUNT" '$2 == m { d = $1 } END { print d }' /proc/mounts)"
    want=" "
    for c in $DATA_CATS; do
        data_on "$c" || continue
        for rel in $(cat_paths "$c"); do
            want="$want$rel "
            cur="$(mounted_at "$rel")"
            if [ "$state" = online ]; then
                if [ -n "$dev" ] && [ "$(echo "$cur" | cut -d' ' -f2)" = "$dev" ] &&
                   [ "$(echo "${cur##* }" | tr A-Z a-z)" = "$(echo "/nuubOS/$rel" | tr A-Z a-z)" ]; then
                    continue
                fi
                release_at "$rel"
                mkdir -p "$DATA_DIR/$rel" "/userdata/$rel" &&
                    mount --bind "$DATA_DIR/$rel" "/userdata/$rel" ||
                    { log "data: bind of $rel failed"; placeholder "$rel"; }
            else
                case "$cur" in "tmpfs $PLACEHOLDER "*) continue ;; esac
                placeholder "$rel"
            fi
        done
    done
    for m in $(ours); do
        case "$want" in *" ${m#/userdata/} "*) continue ;; esac
        umount -l "$m" 2>/dev/null
    done
    write_data_status "$state"
}

# Eject, Don't Use: the card's folders let go first (open files: busy).
data_release()
{
    for m in $(ours); do
        umount "$m" 2>/dev/null || { apply_data; return 1; }
    done
    return 0
}

data_move()
{
    cat="$1"; where="$2"
    case " $DATA_CATS " in *" $cat "*) ;; *) fail category ;; esac
    case "$where" in sd2|sd1) ;; *) fail where ;; esac
    on="$(value "$DATA_CONF" ON)"
    token="$(value "$DATA_CONF" TOKEN)"
    if data_on "$cat"; then [ "$where" = sd2 ] && { echo "@progress 100"; return 0; }
    else [ "$where" = sd1 ] && { echo "@progress 100"; return 0; }; fi
    [ "$(value "$SD2_STATUS" SD2_STATE)" = ready ] && mounted || fail card
    [ -d "$TF1/users" ] || fail write
    nuubos-emuctl status 2>/dev/null | grep -q '^state=running' && fail game
    if [ "$where" = sd2 ] && [ -z "$on" ]; then
        # The first category on SD2: this card becomes the data card.
        [ -n "$token" ] || token="$(cat /proc/sys/kernel/random/uuid)"
        mkdir -p "$DATA_DIR" && echo "TOKEN=$token" > "$DATA_MARK.tmp" && mv "$DATA_MARK.tmp" "$DATA_MARK" || fail write
        write_data_conf "" "$token" "$(value "$DATA_CONF" CONFLICTS)"
    else
        # Every category on SD2 is on one card.
        data_card || fail card
    fi
    stamp="$(date +%Y%m%d-%H%M%S)"
    if [ "$where" = sd2 ]; then conflicts="$DATA_DIR/conflicts/$stamp"; else conflicts="$TF1/conflicts/$stamp"; fi
    paths="$(cat_paths "$cat")"
    [ -n "$paths" ] || fail write
    log "data: moving $cat to $where"
    # Nothing writes into the folders while they move.
    MOVING="$cat"
    # Done, failed or cancelled (SIGTERM to the job's group, the mover
    # cleans up first): the folders are bound again as the setting says.
    trap 'MOVING=""; announce' EXIT
    trap 'exit 1' TERM INT
    write_data_status moving "$cat"
    for rel in $paths; do placeholder "$rel"; done
    announce
    set --
    for rel in $paths; do
        if [ "$where" = sd2 ]; then set -- "$@" "$rel" "$TF1/$rel" "$DATA_DIR/$rel"
        else set -- "$@" "$rel" "$DATA_DIR/$rel" "$TF1/$rel"; fi
    done
    res="$STATUS_DIR/data-move.result"
    rm -f "$res"
    "$DATA_MOVE" "$conflicts" "$@" 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            "@done "*) echo "${line#@done }" > "$res" ;;
            *) echo "$line" ;;
        esac
    done
    [ -f "$res" ] || { log "data: move of $cat failed"; exit 1; }
    n="$(cat "$res")"; rm -f "$res"
    if [ "$where" = sd2 ]; then
        on="$(echo "$on,$cat" | sed 's/^,//')"
    else
        on="$(echo ",$on," | sed "s/,$cat,/,/; s/^,//; s/,\$//")"
    fi
    write_data_conf "$on" "$token" "$n"
    log "data: $cat moved to $where ($n conflicts)"
    echo "@result $n"
    echo "@progress 100"
}

# The card is gone for good: the category is back on SD1's folders (what
# they held before the move); what the card holds stays there.
data_forget()
{
    data_on "$1" || { echo OK; return 0; }
    data_card && { echo "ERR card"; return 1; }
    on="$(value "$DATA_CONF" ON)"
    on="$(echo ",$on," | sed "s/,$1,/,/; s/^,//; s/,\$//")"
    write_data_conf "$on" "$(value "$DATA_CONF" TOKEN)" 0
    log "data: $1 back on SD1 without the card"
    announce
    echo OK
}

status()
{
    cat "$SD1_STATUS" 2>/dev/null
    cat "$SD2_STATUS" 2>/dev/null || echo "SD2_STATE=unknown"
}

# All card changes are serialised; udev events return at once and the work
# (a repair can take a while) goes on in the background.
locked() { mkdir -p "$STATUS_DIR"; exec 9> "$LOCK"; flock 9; "$@"; }

case "${1:-}" in
    status) status ;;
    hotplug)
        case "${2:-}" in
            add) ( locked attach ) </dev/null >/dev/null 2>&1 & ;;
            remove) ( locked detach ) </dev/null >/dev/null 2>&1 & ;;
            *) exit 2 ;;
        esac
        ;;
    sd2)
        case "${2:-}" in
            attach) locked attach "${3:-}" ;;
            eject) locked eject ;;
            ignore) locked ignore ;;
            # Identify and maybe repair: in the background like an insertion.
            use) ( locked use ) </dev/null >/dev/null 2>&1 & ;;
            prepare) locked prepare ;;
            format) locked format_card "${3:-}" ;;
            *) echo "Usage: nuubos-storagectl sd2 attach|eject|ignore|use|prepare|format CID" >&2; exit 2 ;;
        esac
        ;;
    data)
        case "${2:-}" in
            apply) locked apply_data ;;
            move) locked data_move "${3:-}" "${4:-}" ;;
            forget) locked data_forget "${3:-}" ;;
            *) echo "Usage: nuubos-storagectl data apply|move CAT sd2|sd1|forget CAT" >&2; exit 2 ;;
        esac
        ;;
    *)
        echo "Usage: nuubos-storagectl status | hotplug add|remove DISK | sd2 attach|eject|ignore|use|prepare|format CID | data apply|move|forget" >&2
        exit 2
        ;;
esac
