#!/bin/sh

. /usr/lib/nuubos/exfat-health.sh
. /usr/lib/nuubos/partitions.sh
. /usr/lib/nuubos/userdata.sh

STATUS_DIR=/run/nuubos/storage
STATUS_FILE="$STATUS_DIR/storage.status"
READY_FILE="$STATUS_DIR/ready"

TF1_VIEW="$STATUS_DIR/tf1"

USERDATA_USER_VIEW=/run/nuubos/userdata
ACTIVE_USER_FILE=/run/nuubos/user/active

log()
{
    echo "nuubOS storage: $*" >&2
}

tf1_device()
{
    nuubos_partition "$NUUBOS_PART_USERDATA"
}

mounted_source()
{
    TARGET="$1"

    awk -v m="$TARGET" '
        $2 == m {
            source=$1
        }

        END {
            if (source != "")
                print source
        }
    ' /proc/mounts
}

userdata_source()
{
    mounted_source /userdata
}

ensure_tf1_view()
{
    TF1="$1"

    CURRENT="$(mounted_source "$TF1_VIEW")"

    if [ "$CURRENT" = "$TF1" ]; then
        return 0
    fi

    if [ -n "$CURRENT" ]; then
        umount "$TF1_VIEW" || return 1
    fi

    mkdir -p "$TF1_VIEW"

    mount --bind /userdata "$TF1_VIEW" || return 1
    # SD1 itself: the Data on SD2 folders bound over /userdata never show
    # here (nuubos-storagectl moves through this view).
    mount --make-private "$TF1_VIEW" 2>/dev/null

    [ "$(mounted_source "$TF1_VIEW")" = "$TF1" ]
}

restore_tf1()
{
    TF1="$1"
    CURRENT="$(userdata_source)"

    if [ "$CURRENT" = "$TF1" ]; then
        return 0
    fi

    #
    # A previous run may have left /userdata unmounted while TF1 remains
    # available through the stable TF1 view: rebind that verified view.
    #
    if [ -z "$CURRENT" ]; then
        SOURCE="$(mounted_source "$TF1_VIEW")"

        [ "$SOURCE" = "$TF1" ] || return 1

        mkdir -p /userdata
        mount --bind "$TF1_VIEW" /userdata || return 1

        CURRENT="$(userdata_source)"
    fi

    [ "$CURRENT" = "$TF1" ]
}

deactivate_userdata()
{
    TF1="$1"
    CURRENT="$(userdata_source)"

    [ -n "$CURRENT" ] || return 0

    case "$CURRENT" in
        "$TF1")
            umount /userdata || return 1
            ;;
        *)
            return 1
            ;;
    esac

    [ -z "$(userdata_source)" ]
}

unmount_tf1_view()
{
    CURRENT="$(mounted_source "$TF1_VIEW")"

    if [ -n "$CURRENT" ]; then
        umount "$TF1_VIEW" || return 1
    fi

    return 0
}


unpublish_user_view()
{
    if awk -v m="$USERDATA_USER_VIEW" '
        $2 == m {
            found=1
        }

        END {
            exit !found
        }
    ' /proc/mounts
    then
        # Switching users must not be blocked by stale open file descriptors
        # held by the previous session. Lazy-detach the bind mount; existing
        # descriptors keep their old mount while new opens resolve to the new
        # active-user view.
        umount -l "$USERDATA_USER_VIEW" || return 1
    fi

    rmdir "$USERDATA_USER_VIEW" 2>/dev/null || true
    return 0
}

publish_user_view()
{
    READY="$(
        sed -n 's/^STORAGE_READY=//p' \
            "$STATUS_FILE" 2>/dev/null |
        tail -1
    )"

    #
    # No usable USERDATA means there must be no stale user view.
    #
    if [ "$READY" != "1" ]; then
        return 0
    fi

    #
    # AUTO/SELECT with multiple profiles intentionally has no active user
    # until nuubUI selects one.
    #
    [ -r "$ACTIVE_USER_FILE" ] || return 0

    ACTIVE_USER_ID="$(cat "$ACTIVE_USER_FILE")"

    [ -n "$ACTIVE_USER_ID" ] || return 1
    [ -d "/state/users/$ACTIVE_USER_ID" ] || return 1

    grep -qx \
        "USER_ID=$ACTIVE_USER_ID" \
        "/state/users/$ACTIVE_USER_ID/profile.conf" ||
        return 1

    #
    # A newly-created profile may not exist yet on the selected USERDATA
    # medium. Ensure all STATE profiles have their namespace here.
    #
    nuubos_userdata_prepare_users /userdata || return 1

    #
    # Data on SD2: every profile's folders bound to the card (or covered
    # while it is away) before anything uses them.
    #
    /usr/sbin/nuubos-storagectl data apply >/dev/null 2>&1

    USER_ROOT="/userdata/users/$ACTIVE_USER_ID"

    [ -d "$USER_ROOT" ] || return 1

    mkdir -p /run/nuubos "$USERDATA_USER_VIEW" || return 1

    #
    # The view carries the Data on SD2 folders (rbind) and follows them
    # when the card comes and goes (a slave of the shared /userdata; its
    # own unmount never reaches back).
    #
    mount --make-shared /userdata 2>/dev/null

    mount --rbind \
        "$USER_ROOT" \
        "$USERDATA_USER_VIEW" ||
        return 1

    mount --make-rslave "$USERDATA_USER_VIEW" 2>/dev/null

    awk -v m="$USERDATA_USER_VIEW" '
        $2 == m {
            found=1
        }

        END {
            exit !found
        }
    ' /proc/mounts
}

write_status()
{
    ACTION="$1"
    READY="$2"

    TF1_HEALTH="$(
        nuubos_exfat_health_value "$STATUS_DIR/tf1.health" RESULT
    )"

    [ -n "$TF1_HEALTH" ] || TF1_HEALTH=UNKNOWN

    if [ "$READY" != "1" ]; then
        STORAGE_HEALTH=FAILED
    elif [ "$TF1_HEALTH" = "ERROR" ] || [ "$ACTION" != "NONE" ]; then
        STORAGE_HEALTH=DEGRADED
    else
        STORAGE_HEALTH=OK
    fi

    TMP="$STATUS_FILE.tmp"

    cat > "$TMP" <<EOF2
STORAGE_READY=$READY
STORAGE_HEALTH=$STORAGE_HEALTH
TF1_HEALTH=$TF1_HEALTH
TF1_DEVICE=$TF1
ACTION_REQUIRED=$ACTION
EOF2

    mv "$TMP" "$STATUS_FILE"

    if [ "$READY" = "1" ]; then
        : > "$READY_FILE"
    else
        rm -f "$READY_FILE"
    fi
}

#
# USERDATA is always SD1 (docs/dev/platform.md "SD2 = games card"); the
# games card in the TF2 slot is nuubos-storagectl's.
#
detect_and_select()
{
    mkdir -p "$STATUS_DIR"

    TF1="$(tf1_device)" || {
        log "unable to derive TF1 USERDATA device"
        return 1
    }

    TF1_HEALTH_STATE="$(
        nuubos_exfat_health_value "$STATUS_DIR/tf1.health" RESULT
    )"

    case "$TF1_HEALTH_STATE" in
        HEALTHY|REPAIRED)
            if restore_tf1 "$TF1" &&
               ensure_tf1_view "$TF1"; then
                write_status NONE 1
                return 0
            fi

            log "TF1 health is good but USERDATA activation failed"
            ;;
        *)
            log "TF1 USERDATA unavailable: health=${TF1_HEALTH_STATE:-UNKNOWN}"
            ;;
    esac

    #
    # Never leave a failed or unqualified TF1 mounted rw.
    #
    deactivate_userdata "$TF1" || {
        log "unable to deactivate unhealthy TF1 USERDATA"
        return 1
    }

    unmount_tf1_view || {
        log "unable to unmount unhealthy TF1 recovery view"
        return 1
    }

    write_status REPAIR_TF1 0
    return 0
}

stop_storage()
{
    TF1="$(tf1_device 2>/dev/null || true)"

    if [ -n "$TF1" ]; then
        restore_tf1 "$TF1" 2>/dev/null || true
    fi

    CURRENT="$(mounted_source "$TF1_VIEW")"

    if [ -n "$CURRENT" ]; then
        umount "$TF1_VIEW" 2>/dev/null || true
    fi

    rm -f "$STATUS_FILE" "$READY_FILE"

    rmdir "$TF1_VIEW" 2>/dev/null || true
}


start_storage()
{
    #
    # A user bind referring to the previous storage state must never
    # survive a recovery transition.
    #
    unpublish_user_view || return 1

    detect_and_select || return 1

    publish_user_view || {
        log "unable to publish active-user USERDATA view"
        return 1
    }

    #
    # The games card: identified, repaired if dirty and mounted in the
    # background, so a long repair never holds the boot.
    #
    /usr/sbin/nuubos-storagectl sd2 attach </dev/null >/dev/null 2>&1 &

    return 0
}

case "${1:-}" in
    start)
        start_storage
        ;;
    restart)
        start_storage
        ;;
    user-switch)
        # Rebind only the active-user USERDATA view. Physical storage is unchanged.
        unpublish_user_view || exit 1
        publish_user_view || exit 1
        ;;
    stop)
        unpublish_user_view || exit 1
        stop_storage
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|user-switch}"
        exit 1
        ;;
esac

exit $?
