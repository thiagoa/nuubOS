#!/bin/sh
# nuubOS Syncthing session (EPIC-034).

DAEMON=/usr/sbin/nuubos-syncd
PIDFILE=/run/nuubos/syncd.pid
SOCKET=/run/nuubos/syncd.sock
GUI_SOCKET=/run/nuubos/syncthing/gui.sock

syncd_running()
{
    [ -r "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$PID" ] || return 1
    [ "$(tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p')" = "$DAEMON" ]
}

start_service()
{
    mkdir -p /run/nuubos
    syncd_running && return 0
    rm -f "$PIDFILE" "$SOCKET" "$GUI_SOCKET"
    "$DAEMON" >/run/nuubos/syncd.log 2>&1 &
    return 0
}

stop_service()
{
    if syncd_running; then
        kill -TERM "$PID" 2>/dev/null || true
        # Until it is gone (it stops Syncthing first): an old syncd
        # still exiting removed the socket of the new one on restart.
        I=0
        while [ -d "/proc/$PID" ] && [ "$I" -lt 100 ]; do
            sleep 0.1
            I=$((I + 1))
        done
    fi
    rm -f "$PIDFILE" "$SOCKET" "$GUI_SOCKET"
    return 0
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
