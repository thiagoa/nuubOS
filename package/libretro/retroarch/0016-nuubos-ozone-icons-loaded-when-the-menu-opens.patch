From: nuubOS Project <noreply@nuubos.invalid>
Subject: [PATCH] nuubOS Ozone loads its icon textures when the menu opens

ozone_context_reset() loaded every icon texture (sidebar, theme and
entry icons, ~120 textures of 256x256) whenever a video context was
created, so every game started with ~34 MB of GPU buffers and ~44 MB of
RetroArch's resident memory for a menu that nuubOS opens only on
request (measured on the H700, God of War: RSS 263 -> 219 MB). Fonts,
layout and the rest of the reset stay as they were; the icons are loaded
by the first ozone_toggle() that opens the menu (or at once when the
menu is already open at the reset).

Upstream-Status: Inappropriate [nuubOS specific]
---
--- a/menu/drivers/ozone.c
+++ b/menu/drivers/ozone.c
@@ -9684,8 +9684,74 @@
    ozone->flags |= OZONE_FLAG_NEED_COMPUTE;
 }
 
+/* nuubOS: the icon textures (sidebar, theme, entries: ~120 textures of
+ * 256x256, ~34 MB of GPU memory and ~44 MB of RetroArch's RSS on the
+ * H700) are loaded the first time the menu opens, not when a game's video
+ * context is created: in nuubOS the menu is opened only on request. */
+static bool nuubos_ozone_textures_pending;
+
+static void ozone_load_textures(ozone_handle_t *ozone);
+
 static void ozone_context_reset(void *data, bool is_threaded)
 {
+   ozone_handle_t *ozone      = (ozone_handle_t*) data;
+
+   if (ozone)
+   {
+      settings_t *settings = config_get_ptr();
+
+      ozone->flags |= OZONE_FLAG_HAS_ALL_ASSETS;
+
+      if (settings->bools.menu_ignore_missing_assets)
+         ozone->flags2 |= OZONE_FLAG2_IGNORE_MISSING_ASSETS;
+
+      ozone_set_layout(ozone, settings->paths.directory_assets,
+            settings->bools.ozone_collapse_sidebar, is_threaded);
+
+      if (menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE)
+         ozone_load_textures(ozone);
+      else
+         nuubos_ozone_textures_pending = true;
+
+      gfx_display_deinit_white_texture();
+      gfx_display_init_white_texture();
+
+      /* Horizontal list */
+      ozone_context_reset_horizontal_list(ozone);
+
+      /* State reset */
+      ozone->flags                       &= ~(OZONE_FLAG_DRAW_OLD_LIST
+                                            | OZONE_FLAG_FADE_DIRECTION
+                                            | OZONE_FLAG_CURSOR_IN_SIDEBAR
+                                            | OZONE_FLAG_CURSOR_IN_SIDEBAR_OLD
+                                            | OZONE_FLAG_MSGBOX_STATE
+                                            | OZONE_FLAG_MSGBOX_STATE_OLD
+                                             );
+
+      ozone->flags2                      &= ~OZONE_FLAG2_CURSOR_WIGGLING;
+
+      /* Animations */
+      ozone->animations.cursor_alpha      = 1.0f;
+      ozone->animations.scroll_y          = 0.0f;
+      ozone->animations.list_alpha        = 1.0f;
+      ozone->animations.alpha             = 1.0f;
+
+      /* Thumbnails */
+      ozone_update_thumbnail_image(ozone);
+      ozone_update_savestate_thumbnail_image(ozone);
+
+      if (ozone->flags & OZONE_FLAG_HAS_ALL_ASSETS || ozone->flags2 & OZONE_FLAG2_IGNORE_MISSING_ASSETS)
+         ozone_restart_cursor_animation(ozone);
+
+      /* Screensaver */
+      menu_screensaver_context_destroy(ozone->screensaver);
+   }
+
+   video_driver_monitor_reset();
+}
+
+static void ozone_load_textures(ozone_handle_t *ozone)
+{
    static const char *OZONE_TAB_TEXTURES_FILES[OZONE_TAB_TEXTURE_LAST] = {
       "retroarch.png", /* MAIN_MENU */
       "settings.png",  /* SETTINGS_TAB */
@@ -9704,20 +9770,10 @@
       "cursor_border.png"
    };
    unsigned i;
-   ozone_handle_t *ozone      = (ozone_handle_t*) data;
-
-   if (ozone)
-   {
-      settings_t *settings = config_get_ptr();
-
-      ozone->flags |= OZONE_FLAG_HAS_ALL_ASSETS;
-
-      if (settings->bools.menu_ignore_missing_assets)
-         ozone->flags2 |= OZONE_FLAG2_IGNORE_MISSING_ASSETS;
 
-      ozone_set_layout(ozone, settings->paths.directory_assets,
-            settings->bools.ozone_collapse_sidebar, is_threaded);
+   nuubos_ozone_textures_pending = false;
 
+   {
       /* Textures init */
       for (i = 0; i < OZONE_TEXTURE_LAST; i++)
       {
@@ -9760,42 +9816,7 @@
                ozone->icons_path, &ozone->icons_textures[i], TEXTURE_FILTER_MIPMAP_LINEAR, NULL, NULL))
             ozone->flags &= ~OZONE_FLAG_HAS_ALL_ASSETS;
       }
-
-      gfx_display_deinit_white_texture();
-      gfx_display_init_white_texture();
-
-      /* Horizontal list */
-      ozone_context_reset_horizontal_list(ozone);
-
-      /* State reset */
-      ozone->flags                       &= ~(OZONE_FLAG_DRAW_OLD_LIST
-                                            | OZONE_FLAG_FADE_DIRECTION
-                                            | OZONE_FLAG_CURSOR_IN_SIDEBAR
-                                            | OZONE_FLAG_CURSOR_IN_SIDEBAR_OLD
-                                            | OZONE_FLAG_MSGBOX_STATE
-                                            | OZONE_FLAG_MSGBOX_STATE_OLD
-                                             );
-
-      ozone->flags2                      &= ~OZONE_FLAG2_CURSOR_WIGGLING;
-
-      /* Animations */
-      ozone->animations.cursor_alpha      = 1.0f;
-      ozone->animations.scroll_y          = 0.0f;
-      ozone->animations.list_alpha        = 1.0f;
-      ozone->animations.alpha             = 1.0f;
-
-      /* Thumbnails */
-      ozone_update_thumbnail_image(ozone);
-      ozone_update_savestate_thumbnail_image(ozone);
-
-      if (ozone->flags & OZONE_FLAG_HAS_ALL_ASSETS || ozone->flags2 & OZONE_FLAG2_IGNORE_MISSING_ASSETS)
-         ozone_restart_cursor_animation(ozone);
-
-      /* Screensaver */
-      menu_screensaver_context_destroy(ozone->screensaver);
    }
-
-   video_driver_monitor_reset();
 }
 
 static void ozone_collapse_end(void *userdata)
@@ -12811,6 +12832,9 @@
    if (!ozone)
       return;
 
+   if (menu_on && nuubos_ozone_textures_pending)
+      ozone_load_textures(ozone);
+
    /* Fade in animation */
    if (menu_on)
    {
